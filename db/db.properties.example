# Zugang zur Oracle-Datenbank (Schema Brocken, Dienst PDBORCL), angelegt mit manage_user('Brocken', …) (docs/Anweisung.txt).
# Diese Datei nach db.properties kopieren; db.properties kommt nie ins Git.
url=jdbc:oracle:thin:@//localhost:1521/PDBORCL
user=Brocken
# Das Passwort kann hier leer bleiben. Dann fragt die App (Startbild oder Block DATEN) danach und trägt es nach dem
# erfolgreichen Verbinden in db.properties ein (Klartext). Alternativ aus der Umgebungsvariablen BROCKEN_DB_PASSWORD.
password=
